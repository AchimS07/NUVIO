rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Public read for cabin photos; uploads only through the Firebase Console.
    match /cabin-photos/{fileName} {
      allow read: if true;
      allow write: if false;
    }
    // Landing page images (hero.<ext>, intro.<ext>); fall back to illustrations when missing.
    match /site-images/{fileName} {
      allow read: if true;
      allow write: if false;
    }
  }
}
